            $graphics.DrawImage($original, 0, 0, 48, 48)
            $icon = [System.Drawing.Icon]::FromHandle($bitmap.GetHicon())
            $fileStream = [System.IO.File]::Open($DestinationIco, [System.IO.FileMode]::Create)
            $icon.Save($fileStream)
        }
        finally {
            if ($fileStream) { $fileStream.Dispose() }
            if ($icon) { $icon.Dispose() }
            $graphics.Dispose(); $bitmap.Dispose(); $original.Dispose()
        }
    }

    $supportPng = Join-Path $iconFolder 'Suporte.png'
    $supportIco = Join-Path $iconFolder 'Suporte_48.ico'
    $kbPng = Join-Path $iconFolder 'BaseConhecimento.png'
    $kbIco = Join-Path $iconFolder 'BaseConhecimento_48.ico'
    $learnIco = Join-Path $iconFolder 'Aprenda7.ico'
    $iconsReady = $false
    $iconClient = New-Object System.Net.WebClient
    try {
        $iconClient.DownloadFile('https://chat.a7.net.br/assets/img/logo_alpha7.png', $supportPng)
        Copy-Item -LiteralPath $supportPng -Destination $kbPng -Force
        $iconClient.DownloadFile('https://aprenda.a7.net.br/pluginfile.php/1/theme_moove/favicon/1783685431/Favicon.ico', $learnIco)
        Convert-PngToIco -SourcePng $supportPng -DestinationIco $supportIco
        Convert-PngToIco -SourcePng $kbPng -DestinationIco $kbIco
        Remove-Item -LiteralPath $supportPng, $kbPng -Force
        $iconsReady = $true
    }
    catch {
        Write-Host "[!] Nao foi possivel baixar/converter todos os icones: $($_.Exception.Message)" -ForegroundColor Yellow
        Write-Host '[!] Os atalhos serao criados mesmo assim, usando o icone padrao do Windows.' -ForegroundColor Yellow
    }
    finally { $iconClient.Dispose() }

    $shortcuts = @(
        @{ Name = 'Alpha7 Suporte'; Url = 'https://chat.a7.net.br/'; Icon = $supportIco },
        @{ Name = 'Base de Conhecimento'; Url = 'https://kb.a7.net.br/P%C3%A1gina_principal'; Icon = $kbIco },
        @{ Name = 'Aprenda7'; Url = 'https://aprenda.a7.net.br/login/index.php'; Icon = $learnIco }
    )
    foreach ($shortcut in $shortcuts) {
        $shortcutPath = Join-Path $desktop ($shortcut.Name + '.url')
        $shortcutContent = "[InternetShortcut]`r`nURL=$($shortcut.Url)`r`n"
        if (Test-Path -LiteralPath $shortcut.Icon) {
            $shortcutContent += "IconFile=$($shortcut.Icon)`r`nIconIndex=0`r`n"
        }
        [System.IO.File]::WriteAllText($shortcutPath, $shortcutContent, [System.Text.Encoding]::ASCII)
        Write-Host "[+] Atalho criado: $($shortcut.Name)" -ForegroundColor Green
    }

    # Renomeia somente o atalho padrao esperado, sem sobrescrever destino existente.
    $oldA7Shortcut = Join-Path $desktop 'A7Pharma.lnk'
    $newA7Shortcut = Join-Path $desktop 'A7pharma Retaguarda.lnk'
    if ((Test-Path -LiteralPath $oldA7Shortcut) -and -not (Test-Path -LiteralPath $newA7Shortcut)) {
        try {
            $shell = New-Object -ComObject WScript.Shell
            $shortcutInfo = $shell.CreateShortcut($oldA7Shortcut)
            if ($shortcutInfo.TargetPath -match 'A7|Alpha7') {
                Rename-Item -LiteralPath $oldA7Shortcut -NewName 'A7pharma Retaguarda.lnk'
                Write-Host '[+] Atalho A7Pharma renomeado para A7pharma Retaguarda.' -ForegroundColor Green
            }
        }
        catch { Write-Host "[!] Nao foi possivel validar/renomear o atalho A7: $($_.Exception.Message)" -ForegroundColor Yellow }
    }

    # Mantem o atalho do Alpha7 Suporte como link normal; nao desativa validacao SSL do Chrome.
    $ie4uinit = Join-Path $env:SystemRoot 'System32\ie4uinit.exe'
    if (Test-Path $ie4uinit) {
        Start-Process -FilePath $ie4uinit -ArgumentList '-ClearIconCache' -WindowStyle Hidden -Wait -ErrorAction SilentlyContinue
        Start-Process -FilePath $ie4uinit -ArgumentList '-show' -WindowStyle Hidden -ErrorAction SilentlyContinue
    }
    $installationResults.Add('Atalhos e icones: criados')

    # -------------------------------------------------------------------------
    # 8. PAINEL FINAL E LIMPEZA
    # -------------------------------------------------------------------------
    Write-Host "`n=> Limpando arquivos temporarios do instalador..." -ForegroundColor Gray
}
catch {
    $scriptFailed = $true
    Write-Host "`n[ERRO] O processo foi interrompido: $($_.Exception.Message)" -ForegroundColor Red
    $installationResults.Add("FALHA: $($_.Exception.Message)")
}
finally {
    if (Test-Path -LiteralPath $tempDir) {
        Remove-Item -LiteralPath $tempDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}

if ($scriptFailed) {
    Write-Host "`n============================================================" -ForegroundColor Red
    Write-Host ' INSTALACAO INTERROMPIDA - VERIFIQUE A MENSAGEM ACIMA' -ForegroundColor Red
    Write-Host '============================================================' -ForegroundColor Red
}
else {
    if ($printerMode -eq 'Remota/terminal') {
        # No terminal remoto, mantem a saida final enxuta conforme o fluxo proposto.
        Write-Host "`n[OK] Configuracao do terminal finalizada." -ForegroundColor Green
    }
    else {
        Write-Host "`n============================================================" -ForegroundColor Green
        Write-Host '             IMPLANTACAO FINALIZADA' -ForegroundColor Green
        Write-Host '============================================================' -ForegroundColor Green
        Write-Host ("Computador : {0}" -f $env:COMPUTERNAME) -ForegroundColor Cyan
        Write-Host ("IP IPv4    : {0}" -f (Get-IPv4ForSummary)) -ForegroundColor Cyan
        Write-Host ("Impressora : {0}" -f $printerMode) -ForegroundColor Cyan
        Write-Host "`nResumo:" -ForegroundColor Yellow
        foreach ($result in $installationResults) { Write-Host " - $result" }
        Write-Host "`n[OK] Processo concluido. Verifique os itens acima antes de liberar a maquina." -ForegroundColor Green
    }
}

Write-Host ''
Read-Host 'Pressione Enter para fechar' | Out-Null
