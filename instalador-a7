function Read-YesNo {
    param([string]$Prompt, [bool]$DefaultNo = $true)
    while ($true) {
        $answer = Read-Host $Prompt
        if ([string]::IsNullOrWhiteSpace($answer)) { return (-not $DefaultNo) }
        if ($answer -match '^(s|sim)$') { return $true }
        if ($answer -match '^(n|nao|não)$') { return $false }
        Write-Host 'Digite S para Sim ou N para Nao.' -ForegroundColor Yellow
    }
}

function Backup-File {
    param([Parameter(Mandatory=$true)][string]$Path)
    if (Test-Path -LiteralPath $Path) {
        $backup = "$Path.bak_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
        Copy-Item -LiteralPath $Path -Destination $backup -Force
        return $backup
    }
    return $null
}

function Test-InstallerFile {
    param([Parameter(Mandatory=$true)][string]$Path, [Parameter(Mandatory=$true)][string]$DisplayName)
    if (-not (Test-Path -LiteralPath $Path)) { throw "Arquivo nao encontrado: $Path" }
    $file = Get-Item -LiteralPath $Path
    if ($file.Length -lt 50000) { throw "O arquivo de $DisplayName parece corrompido ou incompleto." }

    $stream = [System.IO.File]::OpenRead($Path)
    try {
        $firstBytes = New-Object byte[] 2
        [void]$stream.Read($firstBytes, 0, 2)
    }
    finally { $stream.Dispose() }
    if ($firstBytes[0] -ne 0x4D -or $firstBytes[1] -ne 0x5A) {
        throw "O arquivo baixado nao e um executavel Windows valido."
    }
}

function Download-Installer {
    param([string]$Url, [string]$Destination, [string]$DisplayName)
    Write-Host " -> Baixando $DisplayName..." -ForegroundColor Cyan
    $oldProgress = $ProgressPreference
    $ProgressPreference = 'SilentlyContinue'
    try {
        Invoke-WebRequest -Uri $Url -OutFile $Destination -UseBasicParsing -UserAgent "Mozilla/5.0" -ErrorAction Stop
    }
    catch {
        $ProgressPreference = $oldProgress
        throw "Falha ao baixar $DisplayName : $($_.Exception.Message)"
    }
    finally {
        $ProgressPreference = $oldProgress
    }
    Test-InstallerFile -Path $Destination -DisplayName $DisplayName
}

function Invoke-SilentInstaller {
    param([string]$Path, [string]$Arguments, [string]$DisplayName)
    Write-Host "=> Instalando $DisplayName..." -ForegroundColor Yellow
    Start-Process -FilePath $Path -ArgumentList $Arguments -Wait
    Write-Host "[+] $DisplayName instalado." -ForegroundColor Green
}

# -----------------------------------------------------------------------------
# MACRO DE INSTALACAO (Com Atalhos Restaurados)
# -----------------------------------------------------------------------------
function Invoke-MacroInstaller {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][string]$DisplayName
    )
    Write-Host "=> Instalando $DisplayName..." -ForegroundColor Yellow
    
    try {
        Start-Process -FilePath $Path
        $wshell = New-Object -ComObject WScript.Shell
        
        # 1. Aguarda a janela inicial abrir (ate 30s)
        $windowFound = $false
        $attempts = 0
        $targetTitle = ''
        while (-not $windowFound -and $attempts -lt 60) {
            Start-Sleep -Milliseconds 500
            $activeWindow = Get-Process | Where-Object { $_.MainWindowTitle -match 'A7Pharma' } | Select-Object -First 1
            if ($activeWindow -and -not [string]::IsNullOrWhiteSpace($activeWindow.MainWindowTitle)) {
                $targetTitle = $activeWindow.MainWindowTitle
                $windowFound = $true
            }
            $attempts++
        }

        if (-not $windowFound) {
            throw "A janela de instalacao de $DisplayName nao foi localizada."
        }

        # 2. Foco Unico na tela do instalador
        $wshell.AppActivate($targetTitle) | Out-Null
        Start-Sleep -Seconds 1

        # 3. 1 TAB inicial para garantir avanço
        $wshell.SendKeys('{TAB}')
        Start-Sleep -Milliseconds 500

        # 4. Loop Ultrarrapido: ENTER e atalhos globais
        $contador = 0
        $janelaAberta = $true
        while ($janelaAberta -and $contador -lt 2500) {
            $win = Get-Process | Where-Object { $_.MainWindowTitle -match 'A7Pharma' } | Select-Object -First 1
            if ($win -and -not [string]::IsNullOrWhiteSpace($win.MainWindowTitle)) {
                
                # ENTER puro (aciona o que estiver focado)
                $wshell.SendKeys('{ENTER}')
                
                # Atalhos forçam o clique nos botões mesmo se o foco estiver preso numa caixinha!
                $wshell.SendKeys('%a') # Alt + A (Avançar)
                $wshell.SendKeys('%p') # Alt + P (Próximo)
                $wshell.SendKeys('%c') # Alt + C (Concluir / Complete)
                $wshell.SendKeys('%f') # Alt + F (Finish / Finalizar)
                $wshell.SendKeys('%t') # Alt + T (Terminar)
                
                Start-Sleep -Milliseconds 250
            }
            else {
                # Janela sumiu? Espera 2 segundos para confirmar se encerrou de vez
                Start-Sleep -Seconds 2
                $recheck = Get-Process | Where-Object { $_.MainWindowTitle -match 'A7Pharma' } | Select-Object -First 1
                if (-not $recheck) {
                    $janelaAberta = $false
                }
            }
            $contador++
        }

        Write-Host "[+] $DisplayName instalado com sucesso." -ForegroundColor Green
    }
    catch {
        throw "Erro na instalacao de $DisplayName : $($_.Exception.Message)"
    }
}

function Get-IPv4ForSummary {
    try {
        $configs = Get-NetIPConfiguration | Where-Object { $_.NetAdapter.Status -eq 'Up' -and $_.IPv4Address -and $_.IPv4DefaultGateway }
        foreach ($config in $configs) {
            $name = [string]$config.InterfaceAlias
            if ($name -match 'Virtual|VPN|VMware|VirtualBox|Hyper-V|TAP|TUN|Bluetooth') { continue }
            $ip = $config.IPv4Address | Where-Object { $_.IPAddress -notlike '169.254.*' } | Select-Object -First 1
            if ($ip) { return $ip.IPAddress }
        }
    }
    catch { }
    return 'Nao identificado'
}

