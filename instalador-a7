function Read-YesNo {
    param([string]$Prompt, [bool]$DefaultNo = $true)
    while ($true) {
        $answer = Read-Host $Prompt
        if ([string]::IsNullOrWhiteSpace($answer)) { return (-not $DefaultNo) }
        if ($answer -match '^(s|sim)$') { return $true }
        if ($answer -match '^(n|nao|não)$') { return $false }
        Write-Host 'Digite S para Sim ou N para Nao.' -ForegroundColor Yellow
    }
}

function Get-DecodedString {
    param([Parameter(Mandatory=$true)][string]$Base64)
    return [System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($Base64))
}

function Backup-File {
    param([Parameter(Mandatory=$true)][string]$Path)
    if (Test-Path -LiteralPath $Path) {
        $backup = "$Path.bak_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
        Copy-Item -LiteralPath $Path -Destination $backup -Force
        Write-Host "[+] Backup criado: $backup" -ForegroundColor DarkGray
        return $backup
    }
    return $null
}

function Test-InstallerFile {
    param([Parameter(Mandatory=$true)][string]$Path, [Parameter(Mandatory=$true)][string]$DisplayName)

    if (-not (Test-Path -LiteralPath $Path)) { throw "Arquivo nao encontrado: $Path" }
    $file = Get-Item -LiteralPath $Path
    if ($file.Length -lt 50000) { throw "O arquivo de $DisplayName parece pequeno demais ($($file.Length) bytes). Download interrompido ou resposta HTML recebida." }

    $stream = [System.IO.File]::OpenRead($Path)
    try {
        $firstBytes = New-Object byte[] 2
        [void]$stream.Read($firstBytes, 0, 2)
    }
    finally { $stream.Dispose() }
    if ($firstBytes[0] -ne 0x4D -or $firstBytes[1] -ne 0x5A) {
        throw "O arquivo de $DisplayName nao parece ser um executavel Windows valido (assinatura MZ ausente)."
    }

    $signature = Get-AuthenticodeSignature -FilePath $Path
    if ($signature.Status -eq 'Valid') {
        Write-Host "[+] Assinatura digital valida: $DisplayName" -ForegroundColor Green
    }
    elseif ($signature.Status -eq 'NotSigned') {
        Write-Host "[!] $DisplayName nao possui assinatura digital. Origem: $((Get-Item $Path).Length) bytes. (Instalacao permitida)" -ForegroundColor Yellow
    }
    else {
        throw "A verificacao de assinatura de $DisplayName retornou '$($signature.Status)'. Instalacao bloqueada por seguranca."
    }
}

function Download-Installer {
    param([string]$Url, [string]$Destination, [string]$DisplayName)
    Write-Host " -> Baixando $DisplayName..." -ForegroundColor Cyan
    $client = New-Object System.Net.WebClient
    try { $client.DownloadFile($Url, $Destination) }
    finally { $client.Dispose() }
    Test-InstallerFile -Path $Destination -DisplayName $DisplayName
}

# -----------------------------------------------------------------------------
# NOVA FUNCAO DE INSTALACAO: METODO INFALIVEL VIA ARQUIVO .BAT
# Burlamos as limitacoes do PowerShell escrevendo o comando puro para o Windows
# -----------------------------------------------------------------------------
function Invoke-Installer {
    param(
        [Parameter(Mandatory=$true)][string]$Path,
        [Parameter(Mandatory=$true)][string]$Arguments,
        [Parameter(Mandatory=$true)][string]$DisplayName
    )
    Write-Host "=> Instalando $DisplayName em modo oculto..." -ForegroundColor Yellow
    
    try {
        $batPath = "$Path.bat"
        $batContent = "@echo off`r`n`"$Path`" $Arguments"
        [System.IO.File]::WriteAllText($batPath, $batContent, [System.Text.Encoding]::ASCII)
        
        $process = Start-Process -FilePath "cmd.exe" -ArgumentList "/c `"$batPath`"" -Wait -PassThru -WindowStyle Hidden
        
        if ($process.ExitCode -notin @(0, 3010, 1641)) {
            Write-Host "[!] $DisplayName concluiu com codigo $($process.ExitCode)." -ForegroundColor Yellow
        }
        else {
            Write-Host "[+] $DisplayName instalado com sucesso." -ForegroundColor Green
        }
        
        # Limpa o bat apos a instalacao
        Remove-Item -Path $batPath -Force -ErrorAction SilentlyContinue
    }
    catch {
        throw "Erro ao iniciar instalador do $DisplayName : $($_.Exception.Message)"
    }
}

function Get-IPv4ForSummary {
    try {
        $configs = Get-NetIPConfiguration | Where-Object { $_.NetAdapter.Status -eq 'Up' -and $_.IPv4Address -and $_.IPv4DefaultGateway }
        foreach ($config in $configs) {
            $name = [string]$config.InterfaceAlias
            if ($name -match 'Virtual|VPN|VMware|VirtualBox|Hyper-V|TAP|TUN|Bluetooth') { continue }
            $ip = $config.IPv4Address | Where-Object { $_.IPAddress -notlike '169.254.*' } | Select-Object -First 1
            if ($ip) { return $ip.IPAddress }
        }
        $fallback = Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | Where-Object { $_.IPAddress -ne '127.0.0.1' -and $_.IPAddress -notlike '169.254.*' -and $_.AddressState -eq 'Preferred' } | Select-Object -First 1
        if ($fallback) { return $fallback.IPAddress }
    }
    catch { }
    return 'Nao identificado'
}

