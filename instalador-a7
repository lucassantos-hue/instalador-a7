            $bw.Write([byte]128); $bw.Write([byte]128); $bw.Write([byte]0); $bw.Write([byte]0)
            $bw.Write([uint16]1); $bw.Write([uint16]32)
            $bw.Write([uint32]$pngBytes.Length); $bw.Write([uint32]22)
            $bw.Write($pngBytes)
            $bw.Flush()
        }
        finally {
            if ($ms) { $ms.Dispose() }
            if ($fs) { $fs.Dispose() }
            if ($g) { $g.Dispose() }
            if ($bmp) { $bmp.Dispose() }
            if ($srcImg) { $srcImg.Dispose() }
        }
