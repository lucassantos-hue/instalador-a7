    function Convert-PngToIco {
        param([string]$SourcePng, [string]$DestinationIco)
        $srcImg = [System.Drawing.Image]::FromFile($SourcePng)
        $bmp = New-Object System.Drawing.Bitmap 128, 128, ([System.Drawing.Imaging.PixelFormat]::Format32bppArgb)
        $g = [System.Drawing.Graphics]::FromImage($bmp)
        $ms = New-Object System.IO.MemoryStream
        $fs = $null
        try {
            $g.Clear([System.Drawing.Color]::Transparent)
            $g.InterpolationMode  = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
            $g.SmoothingMode      = [System.Drawing.Drawing2D.SmoothingMode]::HighQuality
            $g.PixelOffsetMode    = [System.Drawing.Drawing2D.PixelOffsetMode]::HighQuality
            $g.CompositingQuality = [System.Drawing.Drawing2D.CompositingQuality]::HighQuality
            $g.DrawImage($srcImg, 0, 0, 128, 128)
            $bmp.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png)
            $pngBytes = $ms.ToArray()

            $fs = [System.IO.File]::Open($DestinationIco, [System.IO.FileMode]::Create)
            $bw = New-Object System.IO.BinaryWriter($fs)
            
            # ICONDIR Header
            $bw.Write([uint16]0)
            $bw.Write([uint16]1)
            $bw.Write([uint16]1)

            # ICONDIRENTRY Entry
            $bw.Write([byte]128)
            $bw.Write([byte]128)
            $bw.Write([byte]0)
            $bw.Write([byte]0)
            $bw.Write([uint16]1)
            $bw.Write([uint16]32)
            $bw.Write([uint32]$pngBytes.Length)
            $bw.Write([uint32]22)

            $bw.Write($pngBytes)
            $bw.Flush()
        }
        finally {
            if ($ms) { $ms.Dispose() }
            if ($fs) { $fs.Dispose() }
            if ($g) { $g.Dispose() }
            if ($bmp) { $bmp.Dispose() }
            if ($srcImg) { $srcImg.Dispose() }
        }
    }

    $kbPng = Join-Path $iconFolder 'KB.png'
    $kbIco = Join-Path $iconFolder 'KB_128.ico'
    $chatPng = Join-Path $iconFolder 'Atendimento.png'
    $chatIco = Join-Path $iconFolder 'Atendimento_128.ico'
    $suportePng = Join-Path $iconFolder 'Suporte.png'
    $suporteIco = Join-Path $iconFolder 'Suporte_128.ico'

    $iconClient = New-Object System.Net.WebClient
    try {
        $iconClient.DownloadFile('https://raw.githubusercontent.com/lucassantos-hue/instalador-a7/main/kb.png', $kbPng)
        $iconClient.DownloadFile('https://raw.githubusercontent.com/lucassantos-hue/instalador-a7/main/atendimento.png', $chatPng)
        $iconClient.DownloadFile('https://raw.githubusercontent.com/lucassantos-hue/instalador-a7/main/suporte.png', $suportePng)

        Convert-PngToIco -SourcePng $kbPng -DestinationIco $kbIco
        Convert-PngToIco -SourcePng $chatPng -DestinationIco $chatIco
        Convert-PngToIco -SourcePng $suportePng -DestinationIco $suporteIco

        Remove-Item -LiteralPath $kbPng, $chatPng, $suportePng -Force -ErrorAction SilentlyContinue
    }
    catch {
        Write-Host "[!] Falha ao baixar ou gerar icones personalizados: $($_.Exception.Message)" -ForegroundColor Yellow
        Write-Host '[!] Os atalhos serao criados com o icone padrao do Windows.' -ForegroundColor Yellow
    }
    finally { $iconClient.Dispose() }

    $shortcuts = @(
        @{ Name = 'KB Alpha7';          Url = 'https://kb.a7.net.br/P%C3%A1gina_principal'; Icon = $kbIco },
        @{ Name = 'Atendimento Alpha7'; Url = 'https://chat.a7.net.br/';                    Icon = $chatIco },
        @{ Name = 'Suporte Alpha7';     Url = 'http://suporte.a7.net.br/';                 Icon = $suporteIco }
    )

    foreach ($shortcut in $shortcuts) {
        $shortcutPath = Join-Path $desktop ($shortcut.Name + '.url')
        $shortcutContent = "[InternetShortcut]`r`nURL=$($shortcut.Url)`r`n"
        if (Test-Path -LiteralPath $shortcut.Icon) {
            $shortcutContent += "IconFile=$($shortcut.Icon)`r`nIconIndex=0`r`n"
        }
        [System.IO.File]::WriteAllText($shortcutPath, $shortcutContent, [System.Text.Encoding]::ASCII)
        Write-Host "[+] Atalho criado: $($shortcut.Name)" -ForegroundColor Green
    }

    # Procura e renomeia o atalho do aplicativo tanto no Desktop do usuario atual quanto no Publico
    $desktopLocations = @(
        [Environment]::GetFolderPath('Desktop'),
        [Environment]::GetFolderPath('CommonDesktopDirectory')
    ) | Where-Object { -not [string]::IsNullOrWhiteSpace($_) } | Select-Object -Unique

    $shell = New-Object -ComObject WScript.Shell
    foreach ($loc in $desktopLocations) {
        $candidateOld = Join-Path $loc 'A7Pharma.lnk'
        $candidateNew = Join-Path $loc 'A7Pharma Retaguarda.lnk'

        if (Test-Path -LiteralPath $candidateOld) {
            try {
                $shortcutInfo = $shell.CreateShortcut($candidateOld)
                if ($shortcutInfo.TargetPath -match 'A7|Alpha7') {
                    if (Test-Path -LiteralPath $candidateNew) {
                        Remove-Item -LiteralPath $candidateNew -Force -ErrorAction SilentlyContinue
                    }
                    Rename-Item -LiteralPath $candidateOld -NewName 'A7Pharma Retaguarda.lnk' -Force
                    Write-Host "[+] Atalho renomeado para A7Pharma Retaguarda em: $loc" -ForegroundColor Green
                }
            }
            catch {
                Write-Host "[!] Nao foi possivel renomear o atalho em $loc - $($_.Exception.Message)" -ForegroundColor Yellow
            }
        }
    }

    $ie4uinit = Join-Path $env:SystemRoot 'System32\ie4uinit.exe'
    if (Test-Path $ie4uinit) {
        Start-Process -FilePath $ie4uinit -ArgumentList '-ClearIconCache' -WindowStyle Hidden -Wait -ErrorAction SilentlyContinue
        Start-Process -FilePath $ie4uinit -ArgumentList '-show' -WindowStyle Hidden -ErrorAction SilentlyContinue
    }
    $installationResults.Add('Atalhos e icones: criados')

    # -------------------------------------------------------------------------
    # 8. PAINEL FINAL E LIMPEZA
    # -------------------------------------------------------------------------
    Write-Host "`n=> Limpando arquivos temporarios do instalador..." -ForegroundColor Gray
}
catch {
    $scriptFailed = $true
    Write-Host "`n[ERRO] O processo foi interrompido: $($_.Exception.Message)" -ForegroundColor Red
    $installationResults.Add("FALHA: $($_.Exception.Message)")
}
finally {
    if (Test-Path -LiteralPath $tempDir) {
        Remove-Item -LiteralPath $tempDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}

if ($scriptFailed) {
    Write-Host "`n============================================================" -ForegroundColor Red
    Write-Host ' INSTALACAO INTERROMPIDA - VERIFIQUE A MENSAGEM ACIMA' -ForegroundColor Red
    Write-Host '============================================================' -ForegroundColor Red
}
else {
    if ($printerMode -eq 'Remota/terminal') {
        Write-Host "`n[OK] Configuracao do terminal finalizada." -ForegroundColor Green
    }
    else {
        Write-Host "`n============================================================" -ForegroundColor Green
        Write-Host '             IMPLANTACAO FINALIZADA' -ForegroundColor Green
        Write-Host '============================================================' -ForegroundColor Green
        Write-Host ("Computador : {0}" -f $env:COMPUTERNAME) -ForegroundColor Cyan
        Write-Host ("IP IPv4    : {0}" -f (Get-IPv4ForSummary)) -ForegroundColor Cyan
        Write-Host ("Impressora : {0}" -f $printerMode) -ForegroundColor Cyan
        Write-Host "`nResumo:" -ForegroundColor Yellow
        foreach ($result in $installationResults) { Write-Host " - $result" }
        Write-Host "`n[OK] Processo concluido. Verifique os itens acima antes de liberar a maquina." -ForegroundColor Green
    }
}

Write-Host ''
Read-Host 'Pressione Enter para fechar' | Out-Null
